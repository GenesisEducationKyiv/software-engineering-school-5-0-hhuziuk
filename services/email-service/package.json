{
  "name": "email-service",
  "version": "1.0.0",
  "description": "Stateless microservice for sending templated emails",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build && cp -r src/templates dist/templates",
    "start": "npm run build && node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test:integration:up": "docker compose -f docker compose.test.yml up -d --build",
    "test:integration": "npm run test:integration:up && jest --config jest.integration.config.js --runInBand",
    "test:integration:down": "docker compose -f docker compose.test.yml down --volumes",
    "test": " npm run test:integration && npm run test:integration:down"
  },
  "dependencies": {
    "@eslint/js": "^9.31.0",
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.7.15",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/common": "^11.1.1",
    "@nestjs/core": "^11.1.1",
    "@nestjs/microservices": "^11.1.3",
    "@nestjs/platform-express": "^11.1.1",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.8",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.0",
    "handlebars": "^4.7.7",
    "nodemailer": "^7.0.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "ts-jest": "^29.4.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "11.0.5",
    "@nestjs/testing": "^11.1.1",
    "@types/amqplib": "^0.10.7",
    "@types/handlebars": "^4.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.16.3",
    "@types/nodemailer": "^6.4.17",
    "eslint": "^9.28.0",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "^30.0.5",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.36.0"
  }
}
